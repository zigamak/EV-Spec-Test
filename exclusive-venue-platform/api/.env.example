# Copy to .env (gitignored) and fill in from the Supabase project settings.
# This project uses Supabase's newer API key system (sb_publishable_.../
# sb_secret_...) with asymmetric JWT signing — no shared HS256 secret.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# AI_PROVIDER selects which key below is actually used (app/core/llm.py):
# openai | anthropic | gemini. Switching providers is just this + that
# provider's key — no code changes anywhere.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
RESEND_WEBHOOK_SECRET=
ENVIRONMENT=development

# Read directly by migrations/env.py at repo root, not by pydantic-settings.
SUPABASE_DB_URL=
