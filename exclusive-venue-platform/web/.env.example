# Copy to .env.local (gitignored) and fill in from the Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# FastAPI dev server (api/), normally http://localhost:8000
# 127.0.0.1, not localhost: on Windows, localhost resolves to ::1 (IPv6)
# first, uvicorn binds IPv4 only, and every connection stalls ~2s waiting
# for the IPv6 attempt to fail before falling back. Measured 16 Jul.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Product 4 marketplace checkout (StripeCheckoutForm.tsx) — publishable
# key only (safe to expose client-side); the secret key lives in
# api/.env, never here.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
